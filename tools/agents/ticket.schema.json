{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Agent Ticket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "objective",
    "mode",
    "allowed_paths",
    "forbidden_paths",
    "dependency_commit",
    "execution_contract_version",
    "execution_checks",
    "output_requirements",
    "max_repair_rounds"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "objective": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "enum": ["read_only", "write"]},
    "allowed_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "forbidden_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dependency_commit": {"type": "string", "minLength": 1},
    "execution_contract_version": {"const": 2},
    "execution_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {"kind": {"const": "git_diff_check"}}
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "modules"],
            "properties": {
              "kind": {"const": "python_unittest"},
              "modules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "godot_path", "project_path", "arguments", "timeout_seconds"],
            "properties": {
              "kind": {"const": "godot_test"},
              "godot_path": {"type": "string", "minLength": 1},
              "project_path": {"type": "string", "minLength": 1},
              "arguments": {"type": "array", "items": {"type": "string"}},
              "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
            }
          }
        ]
      }
    },
    "output_requirements": {"type": "array", "items": {"type": "string"}},
    "max_repair_rounds": {"type": "integer", "minimum": 0, "maximum": 2},
    "context": {"type": "array", "items": {"type": "string"}},
    "require_runtime_identity": {"type": "boolean", "default": true},
    "keep_worktree": {"type": "boolean", "default": false}
  }
}
